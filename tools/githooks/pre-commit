#!/usr/bin/env bash
# Nothing deployment-specific or personal may be recorded: scan what this commit would record,
# then (when installed) gitleaks for secret shapes. Install with tools/install-hooks.sh.
set -u
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
python3 "$here/../publiccheck.py" --staged || exit 1
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner
  code=$?
  if [ "$code" -eq 1 ]; then
    echo "publiccheck: gitleaks found a possible secret in the staged changes (value redacted above)." >&2
    echo "  false positive: add '# gitleaks:allow' on that line. Real secret: remove it and rotate it." >&2
    exit 1
  elif [ "$code" -gt 1 ]; then
    if [ "${LOCAL_LLM_MCP_ALLOW_NO_GITLEAKS:-}" = "1" ]; then
      echo "publiccheck: gitleaks could not run (exit $code); allowed by LOCAL_LLM_MCP_ALLOW_NO_GITLEAKS=1." >&2
    else
      echo "publiccheck: gitleaks is installed but could not run (exit $code) — refusing rather than" >&2
      echo "  recording a commit no secret scanner has read. Fix it, or commit once with" >&2
      echo "  LOCAL_LLM_MCP_ALLOW_NO_GITLEAKS=1 (the content and identity gates still run)." >&2
      exit 1
    fi
  fi
fi
exit 0
