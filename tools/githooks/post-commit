#!/usr/bin/env bash
# Optional: push each commit made on a topic branch as soon as it lands, ready for a pull request
# (the pre-push gate still runs). Commits on main are never pushed: main moves by merging a pull request.
# Enable per clone with:  tools/install-hooks.sh --autopush   (git config local-llm-mcp.autopush true)
[ "$(git config --bool --get local-llm-mcp.autopush 2>/dev/null)" = "true" ] || exit 0
branch=$(git symbolic-ref --short -q HEAD) || exit 0      # detached HEAD: nothing to publish
if [ "$branch" = "main" ]; then
  echo "post-commit: not pushed — main is published by merging a pull request; commit on a branch instead." >&2
  exit 0
fi
if git rev-parse -q --verify "@{upstream}" >/dev/null 2>&1; then
  git push --quiet
else
  git push --quiet -u origin "$branch"
fi || echo "post-commit: the push was refused or failed; the commit is local only." >&2
exit 0
